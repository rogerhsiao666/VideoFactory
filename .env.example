OPENAI_API_KEY=sk-...
PEXELS_API_KEY=...

# local（預設）不呼叫 AI 審稿；hybrid 本機通過後再呼叫 AI；ai 只用 AI。
CARD_REVIEW_MODE=local

# cards.py 的等待上限（秒）；SDK 隱藏重試已關閉，API 最多明示嘗試兩次。
CARD_API_REQUEST_TIMEOUT=90
CARD_API_CALL_TIMEOUT=180
CARD_GENERATION_TIMEOUT=900
CARD_PROGRESS_INTERVAL=15

# 每次執行共用 API 預算，包含換模型、換金鑰與失敗重試。
# tokens 是輸入＋輸出總量，不是美元金額；成功依 usage 計算，失敗保守計入上限。
CARD_API_MAX_REQUESTS=80
CARD_API_TOKEN_BUDGET=300000

# 不限制教材修正的總輪數；連續重交已退回內容才視為沒有進展。
CARD_STALLED_RETRY_LIMIT=4
